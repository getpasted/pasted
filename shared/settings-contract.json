{
  "version": 1,
  "factoryReset": "delete_all",
  "pages": [
    { "id": "general", "resetStrategy": "settings" },
    { "id": "notifications", "resetStrategy": "settings" },
    { "id": "hotkeys", "resetStrategy": "settings" },
    { "id": "app-exclusions", "resetStrategy": "settings" },
    { "id": "security", "resetStrategy": "dedicated" },
    { "id": "analysis", "resetStrategy": "dedicated" },
    { "id": "intelligence", "resetStrategy": "dedicated" },
    { "id": "functionality", "resetStrategy": "none" },
    { "id": "internal", "resetStrategy": "none" }
  ],
  "settings": [
    { "key": "onboardingVersion", "owner": "internal", "default": 0, "reset": "factory_only", "visibility": "internal", "mutation": "dedicated", "validation": { "type": "integer", "minimum": 0, "maximum": 1000 } },

    { "key": "language", "owner": "general", "default": "system", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "language" } },
    { "key": "themeMode", "owner": "general", "default": "system", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["system", "cool", "dark", "warm", "2894", "sauced", "vampire", "flux", "808"] } },
    { "key": "textSize", "owner": "general", "default": 16, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 12, "maximum": 24 } },
    { "key": "rowHeight", "owner": "general", "default": "medium", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["small", "medium", "large"] } },
    { "key": "startupView", "owner": "general", "default": "last_active", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["last_active", "clip_history"] } },
    { "key": "enableSounds", "owner": "general", "default": true, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "openAtLogin", "owner": "general", "default": true, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "dockMenubarIcon", "owner": "general", "default": "both", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["auto_hide", "both", "menubar_only"] } },
    { "key": "menubarIconStyle", "owner": "general", "default": "clipboard", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["clipboard", "copycat"] } },
    { "key": "alwaysPastePlainText", "owner": "general", "default": false, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "maxClipSizeMb", "owner": "general", "default": 100, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 1, "maximum": 256 } },
    { "key": "filePreviewMode", "owner": "general", "default": "safe", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["off", "safe", "all"] } },
    { "key": "filePreviewMaxMb", "owner": "general", "default": 25, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 1, "maximum": 64 } },
    { "key": "keepClipCount", "owner": "general", "default": 1000, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 100000 } },
    { "key": "keepClipAgeDays", "owner": "general", "default": 0, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 36500 } },
    { "key": "revisionHistoryLimit", "owner": "general", "default": 10, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 10000 } },
    { "key": "analysisAttemptsPerClip", "owner": "general", "default": 10, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 10000 } },
    { "key": "searchHistoryLimit", "owner": "general", "default": 100, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 10000 } },
    { "key": "searchHistoryAgeDays", "owner": "general", "default": 0, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 36500 } },
    { "key": "trashCapacityCount", "owner": "general", "default": 500, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 100000 } },
    { "key": "trashAgeDays", "owner": "general", "default": 0, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 36500 } },
    { "key": "activityLogCapacity", "owner": "general", "default": 1000, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 100000 } },
    { "key": "activityLogAgeDays", "owner": "general", "default": 0, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "integer", "minimum": 0, "maximum": 36500 } },

    { "key": "captureFeedback", "owner": "notifications", "default": true, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "captureFeedbackIgnored", "owner": "notifications", "default": false, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "captureFeedbackPreview", "owner": "notifications", "default": false, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "captureFeedbackPosition", "owner": "notifications", "default": "top-right", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["top-left", "top-right", "bottom-left", "bottom-right"] } },
    { "key": "captureFeedbackDismissSeconds", "owner": "notifications", "default": 7, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["0", "3", "5", "7", "10", "15", "30"] } },

    { "key": "hudHotkey", "owner": "hotkeys", "default": "Alt+Shift+V", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "seqToggleHotkey", "owner": "hotkeys", "default": "Alt+Shift+C", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "seqPopHotkey", "owner": "hotkeys", "default": "Alt+Shift+X", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "copyLastPipelineHotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteLastPipelineHotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "openTransformationsHotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "openMainWindowHotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "lockAppHotkey", "owner": "hotkeys", "default": "Alt+Shift+L", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip1Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip2Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip3Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip4Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip5Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip6Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip7Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip8Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },
    { "key": "pasteClip9Hotkey", "owner": "hotkeys", "default": "", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 128 } },

    { "key": "blacklistApps", "owner": "app-exclusions", "default": [{ "id": "1", "name": "1Password", "icon": "Lock", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }, { "id": "2", "name": "Passwords", "icon": "Lock", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }, { "id": "3", "name": "Keychain Access", "icon": "Key", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }, { "id": "4", "name": "Bitwarden", "icon": "Shield", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }, { "id": "5", "name": "Dashlane", "icon": "Shield", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }, { "id": "6", "name": "Enpass", "icon": "Shield", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }, { "id": "7", "name": "KeePassXC", "icon": "Shield", "ignoreText": true, "ignoreImages": true, "ignoreFiles": true, "ignoreHotkeys": false }], "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "json_array" } },
    { "key": "excludePrivateBrowserWindows", "owner": "app-exclusions", "default": false, "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "privateBrowserUnavailablePolicy", "owner": "app-exclusions", "default": "capture", "reset": "default", "visibility": "public", "mutation": "direct", "validation": { "type": "choice", "values": ["capture", "exclude_browser"] } },

    { "key": "enableAnalytics", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableBins", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableClipTypes", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableFileFormats", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableContentClassification", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableConcealment", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableNaming", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableNotes", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableNotifications", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableAppLock", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableOcr", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableTranscriptions", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enablePinning", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableProtection", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableQueue", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableRevisions", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableHud", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableHotkeys", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableTrash", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableTransformations", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableActivityLog", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableTypes", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableSources", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableSearch", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableCli", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },
    { "key": "enableHelp", "owner": "functionality", "default": true, "reset": "preserve", "visibility": "public", "mutation": "direct", "validation": { "type": "boolean" } },

    { "key": "appLockEnabled", "owner": "security", "default": false, "reset": "preserve", "visibility": "public", "mutation": "dedicated", "validation": { "type": "boolean" } },
    { "key": "appLockVerifier", "owner": "security", "reset": "preserve", "visibility": "private", "mutation": "dedicated", "validation": { "type": "string", "maximumBytes": 4096 } },
    { "key": "appLockBiometricEnabled", "owner": "security", "reset": "factory_only", "visibility": "internal", "mutation": "dedicated", "validation": { "type": "boolean" } },
    { "key": "appLockSystemAuthEnabled", "owner": "security", "default": false, "reset": "default", "visibility": "public", "mutation": "dedicated", "validation": { "type": "boolean" } },
    { "key": "appLockAppleWatchEnabled", "owner": "security", "default": false, "reset": "default", "visibility": "public", "mutation": "dedicated", "validation": { "type": "boolean" } },
    { "key": "appLockIdleMinutes", "owner": "security", "default": 5, "reset": "default", "visibility": "public", "mutation": "dedicated", "validation": { "type": "choice", "values": ["0", "1", "5", "60", "480"] } },
    { "key": "appLockOnSleep", "owner": "security", "default": true, "reset": "default", "visibility": "public", "mutation": "dedicated", "validation": { "type": "boolean" } },
    { "key": "appLockOnRestart", "owner": "security", "default": true, "reset": "default", "visibility": "public", "mutation": "dedicated", "validation": { "type": "boolean" } },
    { "key": "appLockCaptureWhileLocked", "owner": "security", "default": true, "reset": "default", "visibility": "public", "mutation": "dedicated", "validation": { "type": "boolean" } },

    { "key": "sequentialQueueItems", "owner": "internal", "reset": "factory_only", "visibility": "internal", "mutation": "internal", "validation": { "type": "string", "maximumBytes": 1048576 } },
    { "key": "sequentialQueueActive", "owner": "internal", "reset": "factory_only", "visibility": "internal", "mutation": "internal", "validation": { "type": "boolean" } },
    { "key": "lastExecutedTransformRef", "owner": "internal", "reset": "factory_only", "visibility": "internal", "mutation": "internal", "validation": { "type": "string", "maximumBytes": 1024 } },
    { "key": "pendingFullBackupClientState", "owner": "internal", "reset": "factory_only", "visibility": "internal", "mutation": "internal", "validation": { "type": "string", "maximumBytes": 1048576 } },
    { "key": "backedUpClientState", "owner": "internal", "reset": "factory_only", "visibility": "internal", "mutation": "direct", "validation": { "type": "string", "maximumBytes": 1048576 } }
