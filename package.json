{
  "name": "pasted",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:wcag": "node scripts/audit-wcag.js && node scripts/audit-theme-tokens.js",
    "test:css": "node scripts/audit-css.js && node scripts/test-interaction-css.js",
    "test:security": "node scripts/audit-security.js",
    "test:release": "node scripts/audit-release.js",
    "test:features": "node scripts/audit-features.js",
    "test:collections": "node scripts/audit-clip-collections.js",
    "test:menus": "node scripts/audit-menu-system.js",
    "test:cli": "node scripts/audit-cli-parity.js",
    "test:transformations": "node scripts/audit-transformations.js",
    "test:activity": "node scripts/audit-activity-events.js",
    "test:platform": "node scripts/audit-platform-chrome.js",
    "test:ipc": "node scripts/audit-ipc.js",
    "release:macos:local": "bash scripts/release-macos.sh --local",
    "release:macos": "bash scripts/release-macos.sh",
    "release:macos:verify": "bash scripts/verify-macos-release.sh",
    "release:linux": "bash scripts/release-linux-appimage.sh",
    "icons:generate": "bash scripts/generate-icons.sh",
    "test:all": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && npm run build && npm test && npm run test:css && npm run test:wcag && npm run test:ipc && npm run test:security && npm run test:release && npm run test:features && npm run test:collections && npm run test:menus && npm run test:cli && npm run test:transformations && npm run test:activity && npm run test:platform",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^8.2.1"
  }
}
