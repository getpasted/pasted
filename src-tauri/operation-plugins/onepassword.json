{
  "manifest_version": 1,
  "id": "com.pasted.examples.onepassword",
  "name": "1Password Credential Provider",
  "version": "0.1.0",
  "publisher": "Pasted",
  "description": "Example secret-reference provider for other Pasted extensions.",
  "permissions": [
    { "kind": "process", "executables": ["op"] }
  ],
  "contributions": {
    "operations": [],
    "credential_providers": [
      {
        "id": "onepassword-cli",
        "name": "1Password CLI",
        "provider_kind": "secret_reference",
        "executable": "op",
        "reference_scheme": "op://",
        "user_presence_required": true
      }
    ]
  }
}
